version: "3.8"

services:
  booklending:
    build:
      context: ..
      dockerfile: src/BookLendingService/Dockerfile
    ports:
      - "8080:8080"   # HTTP
      - "8081:8081"   # HTTPS
    volumes:
      - ./data:/app/data
    environment:
      - ASPNETCORE_ENVIRONMENT=Development
      - ConnectionStrings__DefaultConnection=Data Source=/app/data/books.db
      - ASPNETCORE_URLS=http://+:8080;https://+:8081
